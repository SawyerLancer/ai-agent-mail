# ---------- Домен для TLS (нужен только в режиме EVENTS_MODE=webhook) ----------
DOMAIN=mail-bot.example.ru

# ---------- Пачка ----------
PACHCA_TOKEN=токен_бота
PACHCA_CHANNEL_ID=44293082        # id чата, куда падают письма
BOT_USER_ID=833596                # user_id бота: чтобы не реагировать на себя

# Как получать события от Пачки:
#   polling — читаем журнал событий бота, публичный адрес не нужен.
#             В настройках бота включите «Сохранять историю событий».
#   webhook — Пачка стучится на https://DOMAIN/webhook (нужен публичный HTTPS).
EVENTS_MODE=polling
EVENTS_POLL_INTERVAL=3

# Нужен только при EVENTS_MODE=webhook
PACHCA_SIGNING_SECRET=
CHECK_SOURCE_IP=false             # за Caddy здесь будет адрес прокси, поэтому off

# Кто может нажимать кнопки; пусто = все участники чата
ALLOWED_USER_IDS=[]

# ---------- LLM: anthropic | deepseek ----------
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=               # адрес прокси, если прямой доступ закрыт

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

SIGNATURE=                        # подпись в конце письма

# ---------- Почта ----------
EMAIL_ACCOUNT=work                # account_name из мастера mcp-email-server
MAILBOX=INBOX
POLL_INTERVAL=60                  # секунд между проверками почты
MCP_TIMEOUT=120                   # с; подвисший вызов MCP иначе останавливает бота
PREVIEW_CHARS=700
BODY_CHARS_FOR_LLM=6000
DRAFT_TTL_HOURS=48                # ч; потом кнопки черновика гаснут

# ---------- История переписки ----------
HISTORY_CHARS=6000                # вся история в промпте, символов
HISTORY_MAX_MESSAGES=5
HISTORY_SUBJECT_WINDOW_DAYS=60    # склейка по теме, если нет заголовков
BODY_RETENTION_DAYS=90            # сколько хранить тела писем в базе
HISTORY_SAME_DOMAIN=true          # false — только точный адрес (для нескольких людей)
PUBLIC_DOMAINS_EXTRA=             # свои публичные домены, через запятую

# ---------- Память стиля ----------
# Владелец профиля; пусто = MCP_EMAIL_SERVER_EMAIL_ADDRESS
OWNER_EMAIL=
STYLE_ACTIVATE_HITS=2             # подтверждений, чтобы правило заработало
STYLE_MAX_GLOBAL=15               # активных общих правил
STYLE_MAX_PER_RECIPIENT=5         # активных правил на адресата
LLM_TIMEOUT=120                   # с; чтобы джоба не висела на модели

# ---------- Прочее ----------
DB_PATH=/data/bot.sqlite3
LOG_LEVEL=INFO

# ---------- Ящик для mcp-email-server (пример для Яндекса) ----------
# Пароль приложения, а не пароль от аккаунта.
MCP_EMAIL_SERVER_ACCOUNT_NAME=yandex        # должно совпадать с EMAIL_ACCOUNT
MCP_EMAIL_SERVER_EMAIL_ADDRESS=you@yandex.ru
MCP_EMAIL_SERVER_PASSWORD=
MCP_EMAIL_SERVER_IMAP_HOST=imap.yandex.ru
MCP_EMAIL_SERVER_IMAP_PORT=993
MCP_EMAIL_SERVER_IMAP_SSL=true
MCP_EMAIL_SERVER_IMAP_START_SSL=false
MCP_EMAIL_SERVER_IMAP_VERIFY_SSL=true
MCP_EMAIL_SERVER_IMAP_USER_NAME=you@yandex.ru
MCP_EMAIL_SERVER_SMTP_HOST=smtp.yandex.ru
MCP_EMAIL_SERVER_SMTP_PORT=465
MCP_EMAIL_SERVER_SMTP_SSL=true
MCP_EMAIL_SERVER_SMTP_START_SSL=false
MCP_EMAIL_SERVER_SMTP_VERIFY_SSL=true
MCP_EMAIL_SERVER_SMTP_USER_NAME=you@yandex.ru
MCP_EMAIL_SERVER_SAVE_TO_SENT=true
MCP_EMAIL_SERVER_SENT_FOLDER_NAME=Sent
